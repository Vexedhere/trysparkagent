# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is already listed in .gitignore.
#
# Both variables below are safe to expose to the browser (NEXT_PUBLIC_*),
# but they should still be set via environment variables / your hosting
# provider's dashboard (e.g. Netlify) rather than hardcoded in source.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
