# Copy these values to your hosting provider's server-side environment settings.
# Never commit .env.local or paste a live API key into frontend code.
# Supabase public config (required by the login app):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter key used only by app/api/chat/route.ts (server-side; NOT NEXT_PUBLIC_).
OPENROUTER_API_KEY=

# Provider models; adjust these IDs if your OpenRouter account uses different model variants.
# General questions -> Gemini; short/quick answers -> OpenAI GPT; coding -> Claude.
OPENROUTER_GEMINI_MODEL=google/gemini-2.5-flash
OPENROUTER_OPENAI_MODEL=openai/gpt-4o-mini
OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-4

# Optional metadata sent to OpenRouter for attribution.
OPENROUTER_SITE_URL=https://agent.sparkagent.in.net
OPENROUTER_APP_NAME=SparkAgent
